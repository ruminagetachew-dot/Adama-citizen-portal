PORT=5000
MONGODB_USER=<your_atlas_username>
MONGODB_PASSWORD=<your_atlas_password>
MONGODB_CLUSTER=cluster0.nh9male.mongodb.net
MONGODB_DB=adama_citizen
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Email/SMTP Configuration (Optional, falls back to console log mock)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Adama City Citizen Portal" <noreply@adama.gov.et>

# Twilio SMS Configuration (Optional, falls back to console log mock)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890
